package scala
package util

import scala.language.`2.13`
import scala.runtime.Statics
import scala.util.control.NonFatal

import language.experimental.captureChecking
import caps.Control

/** The `Try` type represents a computation that may fail during evaluation by raising an exception.
 *  It holds either a successfully computed value or the exception that was thrown.
 *  This is similar to the [[scala.util.Either]] type, but with different semantics.
 *
 *  Instances of `Try[T]` are an instance of either [[scala.util.Success]][T] or [[scala.util.Failure]][T].
 *
 *  For example, consider a computation that performs division on user-defined input.
 *  `Try` can reduce or eliminate the need for explicit exception handling in all of the places
 *  where an exception might be thrown.
 *
 *  ```scala sc-hidden sc-name:try-imports
 *  import scala.io.StdIn
 *  import scala.util.{Try, Success, Failure}
 *  ```
 *
 *  Example:
 *  ```scala sc:compile sc-compile-with:try-imports
 *   def divide: Try[Int] = {
 *     val dividend = Try(StdIn.readLine("Enter an Int that you'd like to divide:\n").toInt)
 *     val divisor = Try(StdIn.readLine("Enter an Int that you'd like to divide by:\n").toInt)
 *     val problem = dividend.flatMap(x => divisor.map(y => x/y))
 *     problem match {
 *       case Success(v) =>
 *         println("Result of " + dividend.get + "/"+ divisor.get +" is: " + v)
 *         Success(v)
 *       case Failure(e) =>
 *         println("You must've divided by zero or entered something that's not an Int. Try again!")
 *         println("Info from the exception: " + e.getMessage)
 *         divide
 *     }
 *   }
 *
 *  ```
 *
 *  An important property of `Try` shown in the above example is its ability to *pipeline*, or chain, operations,
 *  catching exceptions along the way. The `flatMap` and `map` combinators in the above example each essentially
 *  pass off either their successfully completed value, wrapped in the `Success` type for it to be further operated
 *  upon by the next combinator in the chain, or the exception wrapped in the `Failure` type usually to be simply
 *  passed on down the chain. Combinators such as `recover` and `recoverWith` are designed to provide some type of
 *  default behavior in the case of failure.
 *
 *  *Note*: only non-fatal exceptions are caught by the combinators on `Try` (see [[scala.util.control.NonFatal]]).
 *  Serious system errors, on the other hand, will be thrown.
 *
 *  *Note:*: all Try combinators will catch exceptions and return failure unless otherwise specified in the documentation.
 *
 *  @tparam T the type of the value computed by the `Try`
 */
sealed abstract class Try[+T] extends Product with Serializable { self: Try[T]^ =>

  /** Tests whether this `Try` is a `Failure`.
   *
   *  @return `true` if this is a `Failure`, `false` if it is a `Success`
   */
  def isFailure: Boolean

  /** Tests whether this `Try` is a `Success`.
   *
   *  @return `true` if this is a `Success`, `false` if it is a `Failure`
   */
  def isSuccess: Boolean

  /** Returns the value from this `Success` or the given `default` argument if this is a `Failure`.
   *
   *  *Note:*: This will throw an exception if it is not a success and default throws an exception.
   *
   *  @tparam U the type of the returned value, a supertype of `T`
   *  @param default the default value to return if this is a `Failure` (evaluated lazily)
   *  @return the value if this is a `Success`, otherwise the result of evaluating `default`
   */
  def getOrElse[U >: T](default: => U): U

  /** Returns this `Try` if it's a `Success` or the given `default` argument if this is a `Failure`.
   *
   *  @tparam U the type of the value in the returned `Try`, a supertype of `T`
   *  @param default the fallback `Try` to return if this is a `Failure` (evaluated lazily)
   *  @return this `Try` if it is a `Success`, otherwise the result of evaluating `default`;
   *          any non-fatal exception thrown while evaluating `default` is caught and returned as a `Failure`
   */
  def orElse[U >: T](default: => Try[U]^): Try[U]^{default}

  /** Returns the value from this `Success` or throws the exception if this is a `Failure`.
   *
   *  @return the contained value if this is a `Success`
   *  @throws Throwable the contained exception if this is a `Failure`
   */
  def get: T

  /** Applies the given function `f` to the value if this is a `Success`.
   *
   *  *Note:* If `f` throws, then this method may throw an exception.
   *
   *  @tparam U the (discarded) result type of the function `f`
   *  @param f the function to apply to the value if this is a `Success`
   */
  def foreach[U](f: T => U): Unit

  /** Returns the result of applying the function `f` to the value if this is a `Success`.
   *
   *  @tparam U the type of the value in the resulting `Try`
   *  @param f the function to apply to the value if this is a `Success`
   *  @return the `Try` returned by `f` applied to the value if this is a `Success`, or this `Failure` unchanged;
   *          any non-fatal exception thrown by `f` is caught and returned as a `Failure`
   */
  def flatMap[U](f: T => Try[U]^): Try[U]^{this, f}

  /** Returns a `Success` containing the result of applying `f` to the value if this is a `Success`.
   *
   *  @tparam U the type of the mapped value
   *  @param f the function to apply to the value if this is a `Success`
   *  @return a `Success` containing the result of applying `f` to the value if this is a `Success`, or this `Failure` unchanged;
   *          any non-fatal exception thrown by `f` is caught and returned as a `Failure`
   */
  def map[U](f: T => U): Try[U]^{this, f.only[Control]}

  /** Returns a `Success` containing the result of applying `pf` to the value if `pf` is defined at it.
   *
   *  @tparam U the type of the value returned by the partial function
   *  @param pf the partial function to apply to the value if this is a `Success`
   *  @return a `Success` containing the result of `pf` applied to the value if `pf` is defined at it and this is a `Success`,
   *          a `Failure` with a `NoSuchElementException` if `pf` is not defined at the value,
   *          or this `Failure` unchanged; any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
   */
  def collect[U](pf: PartialFunction[T, U]^): Try[U]^{this, pf.only[Control]}

  /** Returns this `Try` if it is a `Success` whose value satisfies the predicate `p`.
   *
   *  @param p the predicate to test the value against
   *  @return this `Try` if it is a `Success` whose value satisfies `p`, a `Failure` with a `NoSuchElementException` if the value does not satisfy `p`,
   *          or this `Failure` unchanged; any non-fatal exception thrown by `p` is caught and returned as a `Failure`
   */
  def filter(p: T => Boolean): Try[T]^{this, p.only[Control]}

  /** Creates a non-strict filter, which eventually converts this to a `Failure`
   *  if the predicate is not satisfied.
   *
   *  Note: unlike filter, withFilter does not create a new Try.
   *        Instead, it restricts the domain of subsequent
   *        `map`, `flatMap`, `foreach`, and `withFilter` operations.
   *
   *  As Try is a one-element collection, this may be a bit overkill,
   *  but it's consistent with withFilter on Option and the other collections.
   *
   *  @param p   the predicate used to test elements.
   *  @return    an object of class `WithFilter`, which supports
   *             `map`, `flatMap`, `foreach`, and `withFilter` operations.
   *             All these operations apply to those elements of this Try
   *             which satisfy the predicate `p`.
   */
  @inline final def withFilter(p: T => Boolean): WithFilter^{this, p} = new WithFilter(p)

  /** We need a whole WithFilter class to honor the "doesn't create a new
   *  collection" contract even though it seems unlikely to matter much in a
   *  collection with max size 1.
   *
   *  @param p the predicate used to test elements
   */
  final class WithFilter(p: T => Boolean) uses Try.this {
    /** Returns the result of applying the function `f` to the value if it satisfies the predicate `p`.
     *
     *  @tparam U the type of the value returned by the function `f`
     *  @param f the function to apply to the value if it satisfies the predicate
     *  @return a `Success` containing the result of `f` applied to the value if the value satisfies `p` and `f` executes successfully,
     *          a `Failure` with a `NoSuchElementException` if the value does not satisfy `p`,
     *          or a `Failure` containing any non-fatal exception thrown by `f` or `p`
     */
    def map[U](f:     T => U): Try[U]^{Try.this, p.only[Control], f.only[Control]} = Try.this.filter(p).map(f)
    /** Returns the result of applying the function `f` to the value if it satisfies the predicate `p`.
     *
     *  @tparam U the type of the value in the resulting `Try`
     *  @param f the function to apply to the value if it satisfies the predicate
     *  @return the `Try` returned by `f` applied to the value if the value satisfies `p`,
     *          a `Failure` with a `NoSuchElementException` if the value does not satisfy `p`,
     *          or a `Failure` containing any non-fatal exception thrown by `f` or `p`
     */
    def flatMap[U](f: T => Try[U]^): Try[U]^{Try.this, p.only[Control], f}         = Try.this.filter(p).flatMap(f)
    /** Applies the function `f` to the value if it satisfies the predicate `p`.
     *
     *  @tparam U the (discarded) result type of the function `f`
     *  @param f the function to apply to the value if it satisfies the predicate
     */
    def foreach[U](f: T => U): Unit                                                = Try.this.filter(p).foreach(f)
    /** Creates a new `WithFilter` that tests values against both the current predicate `p` and the additional predicate `q`.
     *
     *  @param q the additional predicate to test values against
     *  @return a new `WithFilter` that tests values against both predicates
     */
    def withFilter(q: T => Boolean): WithFilter^{Try.this, p, q}                   = new WithFilter(x => p(x) && q(x))
  }
  

  /** Returns the result of applying `pf` to the exception if this is a `Failure` and `pf` is defined for it.
   *
   *  @tparam U the type of the value in the resulting `Try`, a supertype of `T`
   *  @param pf the partial function to apply to the exception if this is a `Failure`
   *  @return the `Try` produced by applying `pf` to the exception if this is a `Failure` and `pf` is defined for it,
   *          this `Failure` unchanged if `pf` is not defined for the exception, or this `Success` unchanged;
   *          any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
   */
  def recoverWith[U >: T](pf: PartialFunction[Throwable, Try[U]^]^): Try[U]^{this, pf}

  /** Returns a `Success` containing the result of applying `pf` to the exception if this is a `Failure` and `pf` is defined for it.
   *
   *  @tparam U the type of the value in the resulting `Try`, a supertype of `T`
   *  @param pf the partial function to apply to the exception if this is a `Failure`
   *  @return a `Success` containing the result of applying `pf` to the exception if this is a `Failure` and `pf` is defined for it,
   *          this `Failure` unchanged if `pf` is not defined for the exception, or this `Success` unchanged;
   *          any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
   */
  def recover[U >: T](pf: PartialFunction[Throwable, U]^): Try[U]^{this, pf.only[Control]}

  /** Returns `None` if this is a `Failure` or a `Some` containing the value if this is a `Success`.
   *
   *  @return `None` if this is a `Failure`, or `Some(value)` if this is a `Success`
   */
  def toOption: Option[T]

  /** Returns the inner `Try` if this is a `Success` containing a nested `Try`.
   *
   *  @tparam U the type of the value in the inner `Try`
   *  @param ev evidence that `T` is itself a `Try[U]`
   *  @return the inner `Try[U]` if this is a `Success`, or this `Failure` unchanged
   */
  def flatten[U](implicit ev: T <:< Try[U]): Try[U]^{this}

  /** Returns a `Success` containing the exception if this is a `Failure`, or a `Failure` with an `UnsupportedOperationException` if this is a `Success`.
   *
   *  @return a `Success` containing the exception if this is a `Failure`, or a `Failure` with an `UnsupportedOperationException` if this is a `Success`
   */
  def failed: Try[Throwable]

  /** Transforms this `Try` by applying the appropriate function based on whether it is a `Success` or `Failure`.
   *
   *  @tparam U the type of the value in the resulting `Try`
   *  @param s the function to apply to the value if this is a `Success`
   *  @param f the function to apply to the exception if this is a `Failure`
   *  @return the `Try` returned by `s` applied to the value if this is a `Success`, or the `Try` returned by `f` applied to the exception if this is a `Failure`;
   *          any non-fatal exception thrown by `s` or `f` is caught and returned as a `Failure`
   */
  def transform[U](s: T => Try[U]^, f: Throwable => Try[U]^): Try[U]^{s, f}

  /** Returns `Left` containing the exception if this is a `Failure`, or `Right` containing the value if this is a `Success`.
   *
   *  @return `Left(exception)` if this is a `Failure`, or `Right(value)` if this is a `Success`
   */
  def toEither: Either[Throwable, T]

  /** Applies the function `fa` to the exception if this is a `Failure`, or the function `fb` to the value if this is a `Success`.
   *
   *  If `fb` throws an exception when applied, then `fa` is applied to that exception.
   *
   *  @param fa the function to apply to the exception if this is a `Failure`
   *  @param fb the function to apply to the value if this is a `Success`
   *  @return the result of applying the appropriate function
   *
   *  @tparam U the type of the result
   */
  def fold[U](fa: Throwable => U, fb: T => U): U

}

object Try {
  /** Creates a `Try` that holds the result of evaluating the given computation.
   *
   *  The computation is evaluated once, and any non-fatal exception thrown
   *  during evaluation is caught and returned as a `Failure`.
   *
   *  @tparam T the type of the value to be computed
   *  @param r the computation to evaluate
   *  @return a `Success` containing the result of evaluating `r` if no exception is thrown,
   *          or a `Failure` containing the thrown exception if a non-fatal exception occurs
   */
  def apply[T](r: => T): Try[T]^{r.only[Control]} =
    try {
      val r1 = r
      Success(r1)
    } catch {
      case NonFatal(e) => Failure(e)
    }
}

/** A `Try` that contains an exception indicating a failed computation.
 *
 *  @tparam T the type of the value that would have been computed if the computation succeeded
 *  @param exception the exception that caused the computation to fail
 */
final case class Failure[+T](exception: Throwable) extends Try[T] { self: Failure[T]^ =>
  /** Returns `true` since this is a `Failure`. */
  override def isFailure: Boolean = true
  /** Returns `false` since this is a `Failure`. */
  override def isSuccess: Boolean = false
  /** Throws the contained exception since this is a `Failure`. */
  override def get: T = throw exception
  /** Returns the given `default` argument since this `Try` is a `Failure`.
   *
   *  @tparam U the type of the returned value, a supertype of `T`
   *  @param default the default value to return
   */
  override def getOrElse[U >: T](default: => U): U = default
  /** Returns the given `default` argument since this `Try` is a `Failure`.
   *
   *  @tparam U the type of the value in the returned `Try`, a supertype of `T`
   *  @param default the fallback `Try` to return (evaluated lazily)
   *  @return the `default` `Try`; any non-fatal exception thrown while evaluating `default` is caught and returned as a `Failure`
   */
  override def orElse[U >: T](default: => Try[U]^): Try[U]^{default} =
    try default catch { case NonFatal(e) => Failure(e) }
  /** Returns this `Failure` unchanged since it represents a failed computation.
   *
   *  @tparam U the type of the value in the resulting `Try`
   *  @param f the function to apply (ignored)
   *  @return this `Failure` unchanged
   */
  override def flatMap[U](f: T => Try[U]^): Try[U]^{this} = this.asTryOf[U]
  /** Returns this `Failure` unchanged since it cannot be flattened.
   *
   *  @tparam U the type of the value in the inner `Try`
   *  @param ev evidence that `T` is itself a `Try[U]`
   *  @return this `Failure` unchanged
   */
  override def flatten[U](implicit ev: T <:< Try[U]): Try[U]^{this} = this.asTryOf[U]
  /** Does nothing since this is a `Failure`.
   *
   *  @tparam U the (discarded) result type of the function `f`
   *  @param f the function to apply (ignored)
   */
  override def foreach[U](f: T => U): Unit = ()
  /** Transforms this `Failure` by applying the function `f` to its exception.
   *
   *  @tparam U the type of the value in the resulting `Try`
   *  @param s the function to apply if this is a `Success` (ignored)
   *  @param f the function to apply to the exception
   *  @return the `Try` returned by `f` applied to the exception; any non-fatal exception thrown by `f` is caught and returned as a `Failure`
   */
  override def transform[U](s: T => Try[U]^, f: Throwable => Try[U]^): Try[U]^{f} =
    try f(exception) catch { case NonFatal(e) => Failure(e) }
  /** Returns this `Failure` unchanged since it represents a failed computation.
   *
   *  @tparam U the type of the mapped value
   *  @param f the function to apply (ignored)
   *  @return this `Failure` unchanged
   */
  override def map[U](f: T => U): Try[U]^{this} = this.asTryOf[U]
  /** Returns this `Failure` unchanged since it represents a failed computation.
   *
   *  @tparam U the type of the value returned by the partial function
   *  @param pf the partial function to apply (ignored)
   *  @return this `Failure` unchanged
   */
  override def collect[U](pf: PartialFunction[T, U]^): Try[U]^{this} = this.asTryOf[U]
  /** Returns this `Failure` unchanged since it represents a failed computation.
   *
   *  @param p the predicate to test (ignored)
   *  @return this `Failure` unchanged
   */
  override def filter(p: T => Boolean): Try[T]^{this} = this
  /** Applies the given partial function to the exception if it is defined for it.
   *
   *  @tparam U the type of the value in the resulting `Try`, a supertype of `T`
   *  @param pf the partial function to apply to the exception
   *  @return a `Success` containing the result of `pf` if it is defined for the exception, otherwise this `Failure` unchanged; any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
   */
  override def recover[U >: T](pf: PartialFunction[Throwable, U]^): Try[U]^{this, pf.only[Control]} = {
    val marker = Statics.pfMarker
    try {
      val v: U | marker.type = pf.applyOrElse(exception, (x: Throwable) => marker)
      if (marker ne v.asInstanceOf[AnyRef]) Success(v.asInstanceOf[U]) else this
    } catch { case NonFatal(e) => Failure(e) }
  }
  /** Applies the given partial function to the exception if it is defined for it.
   *
   *  @tparam U the type of the value in the resulting `Try`, a supertype of `T`
   *  @param pf the partial function to apply to the exception
   *  @return the `Try` returned by `pf` if it is defined for the exception, otherwise this `Failure` unchanged; any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
   */
  override def recoverWith[U >: T](pf: PartialFunction[Throwable, Try[U]^]^): Try[U]^{this, pf} = {
    val marker = Statics.pfMarker
    try {
      val v = pf.applyOrElse[Throwable, Any /* Should be Try[U]^{pf*} | marker.type */](exception, (x: Throwable) => marker)
      if (marker ne v.asInstanceOf[AnyRef]) v.asInstanceOf[Try[U]] else this
    } catch { case NonFatal(e) => Failure(e) }
  }
  /** Returns a `Success` containing the exception that caused this `Failure`. */
  override def failed: Try[Throwable] = Success(exception)
  /** Returns `None` since this is a `Failure`. */
  override def toOption: Option[T] = None
  /** Returns a `Left` containing the exception since this is a `Failure`. */
  override def toEither: Either[Throwable, T] = Left(exception)
  /** Applies the function `fa` to the exception since this is a `Failure`.
   *
   *  @tparam U the type of the result
   *  @param fa the function to apply to the exception
   *  @param fb the function to apply if this is a `Success` (ignored)
   *  @return the result of applying `fa` to the exception
   */
  override def fold[U](fa: Throwable => U, fb: T => U): U = fa(exception)

  private inline def asTryOf[U]: Try[U]^{this} = this.asInstanceOf[Try[U]]
}

/** A `Try` that contains a successfully computed value.
 *
 *  @tparam T the type of the successfully computed value
 *  @param value the successfully computed value
 */
final case class Success[+T](value: T) extends Try[T] {
  /** Returns `false` since this is a `Success`. */
  override def isFailure: Boolean = false
  /** Returns `true` since this is a `Success`. */
  override def isSuccess: Boolean = true
  /** Returns the value held by this `Success`. */
  override def get = value
  /** Returns the value held by this `Success`.
   *
   *  @tparam U the type of the returned value, a supertype of `T`
   *  @param default the default value to return if this is a `Failure` (ignored)
   */
  override def getOrElse[U >: T](default: => U): U = get
  /** Returns this `Success` since it already contains a value.
   *
   *  @tparam U the type of the value in the returned `Try`, a supertype of `T`
   *  @param default the fallback `Try` to return if this is a `Failure` (ignored)
   *  @return this `Success` unchanged
   */
  override def orElse[U >: T](default: => Try[U]^): Try[U] = this
  /** Returns the result of applying the function `f` to the value.
   *
   *  @tparam U the type of the value in the resulting `Try`
   *  @param f the function to apply to the value
   *  @return the `Try` returned by `f`; any non-fatal exception thrown by `f` is caught and returned as a `Failure`
   */
  override def flatMap[U](f: T => Try[U]^): Try[U]^{f} =
    try f(value) catch { case NonFatal(e) => Failure(e) }
  /** Returns the inner `Try` since this `Success` contains a nested `Try`.
   *
   *  @tparam U the type of the value in the inner `Try`
   *  @param ev evidence that `T` is itself a `Try[U]`
   *  @return the inner `Try[U]`
   */
  override def flatten[U](implicit ev: T <:< Try[U]): Try[U] = value
  /** Applies the function `f` to the value.
   *
   *  @tparam U the (discarded) result type of the function `f`
   *  @param f the function to apply to the value
   */
  override def foreach[U](f: T => U): Unit = f(value)
  /** Transforms this `Success` by applying the function `s` to its value.
   *
   *  @tparam U the type of the value in the resulting `Try`
   *  @param s the function to apply to the value
   *  @param f the function to apply if this is a `Failure` (ignored)
   *  @return the `Try` returned by `s` applied to the value; any non-fatal exception thrown by `s` is caught and returned as a `Failure`
   */
  override def transform[U](s: T => Try[U]^, f: Throwable => Try[U]^): Try[U]^{s} = this flatMap s
  /** Returns a `Success` containing the result of applying `f` to the value.
   *
   *  @tparam U the type of the mapped value
   *  @param f the function to apply to the value
   *  @return a `Success` containing the result of `f` applied to the value; any non-fatal exception thrown by `f` is caught and returned as a `Failure`
   */
  override def map[U](f: T => U): Try[U]^{f.only[Control]} = Try[U](f(value))
  /** Returns a `Success` containing the result of applying `pf` to the value if `pf` is defined at it.
   *
   *  @tparam U the type of the value returned by the partial function
   *  @param pf the partial function to apply to the value
   *  @return a `Success` containing the result of `pf` applied to the value if `pf` is defined at it, a `Failure` with a `NoSuchElementException` if `pf` is not defined at the value; any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
   */
  override def collect[U](pf: PartialFunction[T, U]^): Try[U]^{pf.only[Control]} = {
    val marker = Statics.pfMarker
    try {
      val v = pf.applyOrElse(value, ((x: T) => marker).asInstanceOf[Function[T, U]])
      if (marker ne v.asInstanceOf[AnyRef]) Success(v)
      else Failure(new NoSuchElementException("Predicate does not hold for " + value))
    } catch { case NonFatal(e) => Failure(e) }
  }
  /** Returns this `Success` if the value satisfies the predicate `p`.
   *
   *  @param p the predicate to test the value against
   *  @return this `Success` if the value satisfies `p`, a `Failure` with a `NoSuchElementException` if it doesn't; any non-fatal exception thrown by `p` is caught and returned as a `Failure`
   */
  override def filter(p: T => Boolean): Try[T]^{p.only[Control]} =
    try {
      if (p(value)) this else Failure(new NoSuchElementException("Predicate does not hold for " + value))
    } catch { case NonFatal(e) => Failure(e) }
  /** Returns this `Success` unchanged since it already contains a value.
   *
   *  @tparam U the type of the value in the resulting `Try`, a supertype of `T`
   *  @param pf the partial function to apply if this is a `Failure` (ignored)
   *  @return this `Success` unchanged
   */
  override def recover[U >: T](pf: PartialFunction[Throwable, U]^): Try[U] = this
  /** Returns this `Success` unchanged since it already contains a value.
   *
   *  @tparam U the type of the value in the resulting `Try`, a supertype of `T`
   *  @param pf the partial function to apply if this is a `Failure` (ignored)
   *  @return this `Success` unchanged
   */
  override def recoverWith[U >: T](pf: PartialFunction[Throwable, Try[U]^]^): Try[U] = this
  /** Returns a `Failure` containing an `UnsupportedOperationException` since this is a `Success`. */
  override def failed: Try[Throwable] = Failure(new UnsupportedOperationException("Success.failed"))
  /** Returns a `Some` containing the value since this is a `Success`. */
  override def toOption: Option[T] = Some(value)
  /** Returns a `Right` containing the value since this is a `Success`. */
  override def toEither: Either[Throwable, T] = Right(value)
  /** Applies the function `fb` to the value since this is a `Success`.
   *
   *  @tparam U the type of the result
   *  @param fa the function to apply if this is a `Failure` (ignored)
   *  @param fb the function to apply to the value
   *  @return the result of applying `fb` to the value; if `fb` throws a non-fatal exception, applies `fa` to that exception
   */
  override def fold[U](fa: Throwable => U, fb: T => U): U =
    try { fb(value) } catch { case NonFatal(e) => fa(e) }
}
