USER library/src/scala/util/Try.scala
USER ```
USER /*
USER  * Scala (https://www.scala-lang.org)
USER  *
USER  * Copyright EPFL and Lightbend, Inc. dba Akka
USER  *
USER  * Licensed under Apache License 2.0
USER  * (http://www.apache.org/licenses/LICENSE-2.0).
USER  *
USER  * See the NOTICE file distributed with this work for
USER  * additional information regarding copyright ownership.
USER  */
USER 
USER package scala
USER package util
USER 
USER import scala.language.`2.13`
USER import scala.runtime.Statics
USER import scala.util.control.NonFatal
USER 
USER import language.experimental.captureChecking
USER import caps.Control
USER 
USER /** The `Try` type represents a computation that may fail during evaluation by raising an exception.
USER  *  It holds either a successfully computed value or the exception that was thrown.
USER  *  This is similar to the [[scala.util.Either]] type, but with different semantics.
USER  *
USER  *  Instances of `Try[T]` are an instance of either [[scala.util.Success]][T] or [[scala.util.Failure]][T].
USER  *
USER  *  For example, consider a computation that performs division on user-defined input.
USER  *  `Try` can reduce or eliminate the need for explicit exception handling in all of the places
USER  *  where an exception might be thrown.
USER  *
USER  *  ```scala sc-hidden sc-name:try-imports
USER  *  import scala.io.StdIn
USER  *  import scala.util.{Try, Success, Failure}
USER  *  ```
USER  *
USER  *  Example:
USER  *  ```scala sc:compile sc-compile-with:try-imports
USER  *   def divide: Try[Int] = {
USER  *     val dividend = Try(StdIn.readLine("Enter an Int that you'd like to divide:\n").toInt)
USER  *     val divisor = Try(StdIn.readLine("Enter an Int that you'd like to divide by:\n").toInt)
USER  *     val problem = dividend.flatMap(x => divisor.map(y => x/y))
USER  *     problem match {
USER  *       case Success(v) =>
USER  *         println("Result of " + dividend.get + "/"+ divisor.get +" is: " + v)
USER  *         Success(v)
USER  *       case Failure(e) =>
USER  *         println("You must've divided by zero or entered something that's not an Int. Try again!")
USER  *         println("Info from the exception: " + e.getMessage)
USER  *         divide
USER  *     }
USER  *   }
USER  *
USER  *  ```
USER  *
USER  *  An important property of `Try` shown in the above example is its ability to *pipeline*, or chain, operations,
USER  *  catching exceptions along the way. The `flatMap` and `map` combinators in the above example each essentially
USER  *  pass off either their successfully completed value, wrapped in the `Success` type for it to be further operated
USER  *  upon by the next combinator in the chain, or the exception wrapped in the `Failure` type usually to be simply
USER  *  passed on down the chain. Combinators such as `recover` and `recoverWith` are designed to provide some type of
USER  *  default behavior in the case of failure.
USER  *
USER  *  *Note*: only non-fatal exceptions are caught by the combinators on `Try` (see [[scala.util.control.NonFatal]]).
USER  *  Serious system errors, on the other hand, will be thrown.
USER  *
USER  *  *Note:*: all Try combinators will catch exceptions and return failure unless otherwise specified in the documentation.
USER  *
USER  *  @tparam T the type of the value computed by the `Try`
USER  */
USER sealed abstract class Try[+T] extends Product with Serializable { self: Try[T]^ =>
USER 
USER   /** Returns `true` if the `Try` is a `Failure`, `false` otherwise. */
USER   def isFailure: Boolean
USER 
USER   /** Returns `true` if the `Try` is a `Success`, `false` otherwise. */
USER   def isSuccess: Boolean
USER 
USER   /** Returns the value from this `Success` or the given `default` argument if this is a `Failure`.
USER    *
USER    *  *Note:*: This will throw an exception if it is not a success and default throws an exception.
USER    *
USER    *  @tparam U the type of the returned value, a supertype of `T`
USER    *  @param default the default value to return if this is a `Failure`
USER    *  @return the value if this is a `Success`, otherwise `default`
USER    */
USER   def getOrElse[U >: T](default: => U): U
USER 
USER   /** Returns this `Try` if it's a `Success` or the given `default` argument if this is a `Failure`.
USER    *
USER    *  @tparam U the type of the value in the returned `Try`, a supertype of `T`
USER    *  @param default the fallback `Try` to return if this is a `Failure` (evaluated lazily)
USER    *  @return this `Try` if it is a `Success`, otherwise `default`; any non-fatal exception thrown while evaluating `default` is caught and returned as a `Failure`
USER    */
USER   def orElse[U >: T](default: => Try[U]^): Try[U]^{default}
USER 
USER   /** Returns the value from this `Success` or throws the exception if this is a `Failure`. */
USER   def get: T
USER 
USER   /** Applies the given function `f` if this is a `Success`, otherwise returns `Unit` if this is a `Failure`.
USER    *
USER    *  *Note:* If `f` throws, then this method may throw an exception.
USER    *
USER    *  @tparam U the (discarded) result type of the function `f`
USER    *  @param f the function to apply to the value if this is a `Success`
USER    */
USER   def foreach[U](f: T => U): Unit
USER 
USER   /** Returns the given function applied to the value from this `Success` or returns this if this is a `Failure`.
USER    *
USER    *  @tparam U the type of the value in the resulting `Try`
USER    *  @param f the function to apply to the value if this is a `Success`
USER    *  @return the `Try` returned by `f` applied to the value if this is a `Success`, or this `Failure` unchanged; any non-fatal exception thrown by `f` is caught and returned as a `Failure`
USER    */
USER   def flatMap[U](f: T => Try[U]^): Try[U]^{this, f}
USER 
USER   /** Maps the given function to the value from this `Success` or returns this if this is a `Failure`.
USER    *
USER    *  @tparam U the type of the mapped value
USER    *  @param f the function to apply to the value if this is a `Success`
USER    *  @return a `Success` containing the result of applying `f` to the value if this is a `Success`, or this `Failure` unchanged; any non-fatal exception thrown by `f` is caught and returned as a `Failure`
USER    */
USER   def map[U](f: T => U): Try[U]^{this, f.only[Control]}
USER 
USER   /** Applies the given partial function to the value from this `Success` or returns this if this is a `Failure`.
USER    *
USER    *  @tparam U the type of the value returned by the partial function
USER    *  @param pf the partial function to apply to the value if this is a `Success`
USER    *  @return a `Success` containing the result of `pf` applied to the value if `pf` is defined at it, a `Failure` with a `NoSuchElementException` if `pf` is not defined at the value, or this `Failure` unchanged; any non-fatal exception thrown by `pf` is caught and returned as a `Failure`
USER    */
USER   def collect[U](pf: PartialFunction[T, U]^): Try[U]^{this, pf.only[Control]}
USER 
USER   /** Converts this to a `Failure` if the predicate is not satisfied.
USER    *
USER    *  @param p the predicate to test the value against
USER    *  @return this `Try` if it is a `Success` whose value satisfies `p`, a `Failure` with a `NoSuchElementException` if the value does not satisfy `p`, or this `Failure` unchanged; any non-fatal exception thrown by `p` is caught and returned as a `Failure`
USER    */
USER   def filter(p: T => Boolean): Try[T]^{this, p.only[Control]}
USER 
USER   /** Creates a non-strict filter, which eventually converts this to a `Failure`
USER    *  if the predicate is not satisfied.
USER    *
USER    *  Note: unlike filter, withFilter does not create a new Try.
USER    *        Instead, it restricts the domain of subsequent
USER    *        `map`, `flatMap`, `foreach`, and `withFilter` operations.
USER    *
USER    *  As Try is a one-element collection, this may be a bit overkill,
USER    *  but it's consistent with withFilter on Option and the other collections.
USER    *
USER    *  @param p   the predicate used to test elements.
USER    *  @return    an object of class `WithFilter`, which supports
USER    *             `map`, `flatMap`, `foreach`, and `withFilter` operations.
