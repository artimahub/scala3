USER object Try {
USER   /** Constructs a `Try` using the by-name parameter as a result value.
USER    *
USER    *  The evaluation of `r` is attempted once.
USER    *
USER    *  Any non-fatal exception is caught and results in a `Failure`
USER    *  that holds the exception.
USER    *
USER    *  @tparam T the type of the value to be computed
USER    *  @param r the result value to compute
USER    *  @return the result of evaluating the value, as a `Success` or `Failure`
USER    */
USER   def apply[T](r: => T): Try[T]^{r.only[Control]} =
USER     try {
USER       val r1 = r
USER       Success(r1)
USER     } catch {
USER       case NonFatal(e) => Failure(e)
USER     }
USER }
USER 
USER /** Represents a failed computation, holding the exception that caused the failure.
USER  *
USER  *  @tparam T the type of the value that would have been produced on success.
USER  *  @param exception the exception that caused the failure.
USER  */
USER final case class Failure[+T](exception: Throwable) extends Try[T] { self: Failure[T]^ =>
