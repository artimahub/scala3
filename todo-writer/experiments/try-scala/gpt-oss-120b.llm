USER     /** TODO FILL IN
USER      *
USER      *  @tparam U TODO FILL IN
USER      *  @param f TODO FILL IN
USER      */
USER     def foreach[U](f: T => U): Unit                                                = Try.this.filter(p).foreach(f)
USER     /** Creates a new `WithFilter` that combines the existing predicate `p` with an additional predicate `q`.
